{
  "name": "qvac-invoice-reconciler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reconciliador y auditor de facturas 100% on-device con @qvac/sdk",
  "license": "MIT",
  "engines": {
    "node": ">=22.17",
    "npm": ">=10.9"
  },
  "scripts": {
    "samples": "tsx samples/generate.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "verify": "tsx src/selftest.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:preload",
    "build:preload": "tsc -p tsconfig.preload.json && node -e \"require('fs').renameSync('dist-preload/preload.js','dist/preload.cjs')\" && node -e \"require('fs').rmSync('dist-preload',{recursive:true,force:true})\"",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@qvac/sdk": "^0.17.1",
    "pdf-to-img": "^6.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/electron": "^1.4.38",
    "@types/node": "^22.15.0",
    "@types/pdfkit": "^0.17.3",
    "electron": "^43.4.1",
    "pdfkit": "^0.19.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "main": "dist/main.js"
}
